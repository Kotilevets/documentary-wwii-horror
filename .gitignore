__pycache__/

# Playtest notes for the author only (observer sheet, hypotheses): kept locally
/docs/playtest/AUTHOR_NOTES.md

# References without a clear licence (CLAUDE.md, 6.5): kept locally
/assets/refs/*
!/assets/refs/.gitkeep
